# Supabase project credentials — required for ALL deployed environments.
# Copy this file to .env for local development and fill in your project values.
# In Vercel: set these as Environment Variables (scoped to Production / Preview separately).
#
# DO NOT commit .env — it is git-ignored.

# Your Supabase project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase anon / publishable key (safe to expose in client-side code)
VITE_SUPABASE_ANON_KEY=<your-anon-key>
